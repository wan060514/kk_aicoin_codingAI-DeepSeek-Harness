            "",
            "@brackets"
          ]
        ],
        [
          {
            "__regex": "#?[a-z_$][\\w$]*",
            "__flags": ""
          },
          {
            "cases": {
              "@keywords": "keyword",
              "@builtinVars": "variable.builtin",
              "@default": "identifier"
            }
          }
        ],
        [
          {
            "__regex": "[A-Z][\\w\\$]*",
            "__flags": ""
          },
          "type.identifier"
        ],
        {
