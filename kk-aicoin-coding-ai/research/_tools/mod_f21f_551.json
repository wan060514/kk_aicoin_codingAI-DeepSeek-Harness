    },
    "comments": {
      "lineComment": "//",
      "blockComment": [
        "/*",
        "*/"
      ]
    },
    "brackets": [
      [
        "{",
        "}"
      ],
      [
        "[",
        "]"
      ],
      [
        "(",
        ")"
      ]
    ],
    "onEnterRules": [
      {
        "beforeText": {
          "__regex": "^\\s*\\/\\*\\*(?!\\/)([^\\*]|\\*(?!\\/))*$",
          "__flags": ""
        },
        "afterText": {
          "__regex": "^\\s*\\*\\/$",
          "__flags": ""
        },
        "action": {
          "indentAction": 2,
          "appendText": " * "
        }
      },
      {
        "beforeText": {
          "__regex": "^\\s*\\/\\*\\*(?!\\/)([^\\*]|\\*(?!\\/))*$",
          "__flags": ""
        },
        "action": {
          "indentAction": 0,
          "appendText": " * "
        }
      },
      {
        "beforeText": {
          "__regex": "^(\\t|(\\ \\ ))*\\ \\*(\\ ([^\\*]|\\*(?!\\/))*)?$",
          "__flags": ""
        },
        "action": {
          "indentAction": 0,
          "appendText": "* "
        }
      },
      {
        "beforeText": {
          "__regex": "^(\\t|(\\ \\ ))*\\ \\*\\/\\s*$",
          "__flags": ""
        },
        "action": {
          "indentAction": 0,
          "removeText": 1
        }
      }
    ],
    "autoClosingPairs": [
      {
        "open": "{",
        "close": "}"
      },
      {
        "open": "[",
        "close": "]"
      },
      {
        "open": "(",
        "close": ")"
      },
      {
