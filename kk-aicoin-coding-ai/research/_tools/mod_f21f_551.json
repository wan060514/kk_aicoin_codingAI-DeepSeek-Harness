        }
      ],
      "common": [
        [
          {
            "__regex": "(?!if|for|while|switch|return)([a-zA-Z\\u4E00-\\u9FAF_$][0-9a-zA-Z\\u4E00-\\u9FAF_$]*)(\\s*)(\\()",
            "__flags": ""
          },
          [
