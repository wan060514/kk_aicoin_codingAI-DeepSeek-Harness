            "__flags": ""
          },
          "delimiter"
        ],
        [
          {
            "__regex": "@symbols",
            "__flags": ""
          },
          {
            "cases": {
              "@operators": "delimiter",
              "@default": ""
            }
          }
        ],
        [
          {
            "__regex": "(@digits)[eE]([\\-+]?(@digits))?",
            "__flags": ""
          },
          "number.float"
        ],
        [
          {
            "__regex": "(@digits)\\.(@digits)([eE][\\-+]?(@digits))?",
            "__flags": ""
          },
          "number.float"
        ],
        [
          {
            "__regex": "(@digits)n?",
            "__flags": ""
          },
          "number"
        ],
        [
