          },
          "comment",
          "@comment"
        ],
        [
          {
            "__regex": "\\/\\/.*$",
            "__flags": ""
          },
          "comment"
        ]
      ],
      "comment": [
        [
          {
            "__regex": "[^\\/*]+",
            "__flags": ""
          },
          "comment"
        ],
        [
          {
            "__regex": "\\*\\/",
            "__flags": ""
          },
          "comment",
          "@pop"
        ],
        [
          {
            "__regex": "[\\/*]",
            "__flags": ""
          },
          "comment"
        ]
      ],
      "jsdoc": [
        [
          {
            "__regex": "[^\\/*]+",
            "__flags": ""
          },
          "comment.doc"
        ],
        [
          {
            "__regex": "\\*\\/",
            "__flags": ""
          },
          "comment.doc",
          "@pop"
        ],
        [
          {
            "__regex": "[\\/*]",
            "__flags": ""
          },
          "comment.doc"
        ]
      ],
      "string_double": [
        [
          {
            "__regex": "[^\\\\\"]+",
            "__flags": ""
          },
          "string"
        ],
        [
          {
            "__regex": "@escapes",
            "__flags": ""
          },
          "string.escape"
        ],
        [
          {
            "__regex": "\\\\.",
            "__flags": ""
          },
          "string.escape.invalid"
        ],
        [
          {
            "__regex": "\"",
            "__flags": ""
          },
          "string",
          "@pop"
        ]
      ],
      "string_single": [
        [
          {
            "__regex": "[^\\\\']+",
            "__flags": ""
          },
          "string"
        ],
        [
          {
            "__regex": "@escapes",
            "__flags": ""
          },
          "string.escape"
        ],
        [
          {
            "__regex": "\\\\.",
            "__flags": ""
          },
          "string.escape.invalid"
        ],
        [
          {
            "__regex": "'",
            "__flags": ""
          },
          "string",
          "@pop"
        ]
      ],
      "bracketCounting": [
        [
          {
            "__regex": "\\{",
            "__flags": ""
          },
          "delimiter.bracket",
          "@bracketCounting"
        ],
        [
          {
            "__regex": "\\}",
            "__flags": ""
          },
          "delimiter.bracket",
          "@pop"
        ],
        {
          "include": "common"
        }
      ]
    }
  },
