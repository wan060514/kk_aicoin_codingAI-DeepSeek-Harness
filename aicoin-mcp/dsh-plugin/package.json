{
  "name": "dsh-plugin-aicoin-mcp",
  "version": "0.5.0",
  "private": true,
  "description": "AiCoin MCP bridge for DeepSeek Harness: spawns the local aicoin-mcp stdio server, registers its tools as aicoin_*, and adds a sidebar console panel to start/stop the bridge and inspect the AiCoin client.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "aicoin",
    "mcp",
    "model-context-protocol",
    "cdp",
    "panel"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
